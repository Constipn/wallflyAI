<Window x:Class="Wallfly.Detector.MeetingDetectedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Meeting detected · Microsoft Teams"
        Width="420" Height="90"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        Focusable="False" UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI" Foreground="#292929">
    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#F4364C" />
        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#40808080" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="14" Padding="12,0" Height="45">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#F7F7F8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#EFEFF1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Circle" Fill="#F0F0F0" Stroke="#1F808080" StrokeThickness="1" />
                            <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#292929" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Circle" Property="Fill" Value="#E4E4E6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Border Margin="10,12,2,0" Height="72" VerticalAlignment="Top" CornerRadius="18" Background="White"
                BorderBrush="#2E808080" BorderThickness="1" Padding="15,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="1.5" Direction="270" Opacity="0.16" />
            </Border.Effect>
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Rectangle Width="3" Height="33" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource Accent}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Margin="15,0,10,0" VerticalAlignment="Center">
                    <TextBlock Text="Meeting detected" FontSize="14" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="Microsoft Teams" FontSize="13" Foreground="#6E6E73" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="ErrorText" FontSize="10" Foreground="{StaticResource Accent}" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,2,0,0" />
                </StackPanel>
                <Button x:Name="TakeNotesButton" Grid.Column="2" Style="{StaticResource PillButton}" VerticalAlignment="Center"
                        AutomationProperties.Name="Take notes" Click="OnTakeNotes">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="18" Height="18" Margin="0,0,7,0">
                            <Ellipse Fill="{StaticResource Accent}" />
                            <TextBlock Text="&#xE720;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock x:Name="TakeNotesText" Text="Take notes" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
        <Button x:Name="DismissButton" Style="{StaticResource CloseButton}" Width="24" Height="24"
                HorizontalAlignment="Left" VerticalAlignment="Top" ToolTip="Dismiss for this meeting"
                AutomationProperties.Name="Dismiss for this meeting" Click="OnDismiss" />
    </Grid>
</Window>
