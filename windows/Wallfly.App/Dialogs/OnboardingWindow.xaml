<Window x:Class="Wallfly.App.Dialogs.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:Wallfly.App"
        xmlns:dialogs="clr-namespace:Wallfly.App.Dialogs"
        xmlns:controls="clr-namespace:Wallfly.App.Controls"
        Style="{StaticResource AppWindow}" Title="{x:Static app:Strings.SetUpTitle}"
        Width="690" Height="750" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <controls:VisibleWhen x:Key="VisibleWhen" />
  </Window.Resources>
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="24,22,24,18">
      <TextBlock Text="{x:Static app:Strings.SetUpTitle}" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="27" />
      <TextBlock Text="{x:Static app:Strings.SetUpSubtitle}" FontSize="13" Foreground="{StaticResource Muted}" Margin="0,10,0,0" />
      <ItemsControl ItemsSource="{Binding Steps}" Margin="0,14,0,0" Focusable="False">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="·" Foreground="{StaticResource Muted}" Margin="8,0" FontSize="11" Visibility="{Binding ShowsSeparator, Converter={StaticResource VisibleWhen}}" />
              <TextBlock Text="{Binding Label}" FontSize="11">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource Muted}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter Property="Foreground" Value="{StaticResource Accent}" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
    <Rectangle DockPanel.Dock="Top" Height="1" Fill="{StaticResource Line}" />

    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="20,14">
      <DockPanel>
        <Button DockPanel.Dock="Left" Content="{x:Static app:Strings.SetUpLater}" Command="{Binding SetUpLaterCommand}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="{x:Static app:Strings.Back}" Command="{Binding BackCommand}" Visibility="{Binding ShowBack, Converter={StaticResource VisibleWhen}}" Margin="0,0,10,0" MinWidth="72" />
          <Button x:Name="PrimaryButton" Content="{Binding PrimaryText}" Command="{Binding NextCommand}" Style="{StaticResource PrimaryButton}" IsDefault="True" MinWidth="80" />
        </StackPanel>
      </DockPanel>
    </Border>
    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Error}" Visibility="{Binding Error, Converter={StaticResource VisibleWhen}}" Foreground="{StaticResource Accent}" FontSize="12" TextWrapping="Wrap" Margin="24,8,24,10" />

    <ScrollViewer x:Name="Scroller" Background="{StaticResource Sidebar}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid Margin="24,18,24,24">
        <dialogs:StorageSettingsView DataContext="{Binding Settings}" Visibility="{Binding DataContext.IsStorageStep, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleWhen}}" />
        <dialogs:AiLanguageSettingsView DataContext="{Binding Settings}" Visibility="{Binding DataContext.IsAiStep, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleWhen}}" />
        <StackPanel Visibility="{Binding IsPermissionsStep, Converter={StaticResource VisibleWhen}}">
          <TextBlock Text="{x:Static app:Strings.SectionPermissions}" Style="{StaticResource SectionHeader}" Margin="4,0,0,8" />
          <Border Style="{StaticResource Card}">
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="{Binding MicrophoneButtonText}" Command="{Binding MicrophoneCommand}" VerticalAlignment="Center" Margin="12,0,0,0" />
              <controls:Icon DockPanel.Dock="Left" Size="16" VerticalAlignment="Top" Margin="0,1,10,0">
                <controls:Icon.Style>
                  <Style TargetType="controls:Icon">
                    <Setter Property="Kind" Value="Record" />
                    <Setter Property="Foreground" Value="{StaticResource Muted}" />
                    <Style.Triggers><DataTrigger Binding="{Binding MicrophoneAllowed}" Value="True"><Setter Property="Kind" Value="Check" /><Setter Property="Foreground" Value="{StaticResource Accent}" /></DataTrigger></Style.Triggers>
                  </Style>
                </controls:Icon.Style>
              </controls:Icon>
              <StackPanel>
                <TextBlock Text="{x:Static app:Strings.PermissionMicrophone}" FontSize="13" />
                <TextBlock Text="{Binding MicrophoneDetail}" Style="{StaticResource Meta}" Margin="0,2,0,0" />
              </StackPanel>
            </DockPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,14,0,0">
            <StackPanel>
              <ItemsControl ItemsSource="{Binding OpenIssues}" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <DockPanel Margin="0,0,0,8">
                      <controls:Icon DockPanel.Dock="Left" Kind="Warning" Size="12" Foreground="{StaticResource Accent}" VerticalAlignment="Top" Margin="0,2,7,0" />
                      <TextBlock Text="{Binding}" Foreground="{StaticResource Accent}" FontSize="12" TextWrapping="Wrap" />
                    </DockPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{x:Static app:Strings.FillLater}" Style="{StaticResource Meta}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </DockPanel>
</Window>
