<Window x:Class="Wallfly.App.Dialogs.FolderEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:Wallfly.App"
        xmlns:controls="clr-namespace:Wallfly.App.Controls"
        Style="{StaticResource AppWindow}" Title="{Binding Title}" Width="500" SizeToContent="Height" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner" FocusManager.FocusedElement="{Binding ElementName=NameBox}">
  <Window.Resources>
    <controls:VisibleWhen x:Key="VisibleWhen" />
    <Style x:Key="ChoiceButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <StackPanel Margin="28,24,28,22">
    <!-- The window's own close button (top right) cancels like "Cancel"; the title keeps clear of it. -->
    <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,48,18" />

    <TextBlock Text="{x:Static app:Strings.NameAndIcon}" FontSize="13" FontWeight="Medium" Margin="0,0,0,8" />
    <Border Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="9" Padding="9">
      <DockPanel>
        <Border DockPanel.Dock="Left" Width="35" Height="35" CornerRadius="8" Background="{Binding Background}" Margin="0,0,12,0">
          <controls:Icon Kind="{Binding IconKind}" Size="20" Foreground="{Binding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBox x:Name="NameBox" Style="{StaticResource PlainTextBox}" FontSize="16" VerticalAlignment="Center" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static app:Strings.FolderName}" />
      </DockPanel>
    </Border>
    <ItemsControl ItemsSource="{Binding Icons}" Margin="0,10,0,0" AutomationProperties.Name="{x:Static app:Strings.ChooseIcon}">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Button Command="{Binding DataContext.SelectIconCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                  ToolTip="{Binding Label}" AutomationProperties.Name="{Binding Label}" Height="38" Margin="2" Padding="0" BorderThickness="1.5">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource ChoiceButton}">
                <Setter Property="BorderBrush" Value="Transparent" />
                <Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="BorderBrush" Value="{Binding DataContext.Foreground, RelativeSource={RelativeSource AncestorType=Window}}" /><Setter Property="Background" Value="{Binding DataContext.Background, RelativeSource={RelativeSource AncestorType=Window}}" /></DataTrigger></Style.Triggers>
              </Style>
            </Button.Style>
            <controls:Icon Kind="{Binding Kind}" Size="17" Foreground="{Binding DataContext.Foreground, RelativeSource={RelativeSource AncestorType=Window}}" />
          </Button>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <TextBlock Text="{x:Static app:Strings.FolderColorLabel}" FontSize="13" FontWeight="Medium" Margin="0,18,0,8" />
    <ItemsControl ItemsSource="{Binding Colors}" AutomationProperties.Name="{x:Static app:Strings.FolderColorLabel}">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Button Command="{Binding DataContext.SelectColorCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                  ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}" Height="34" Margin="2" Padding="0" Background="{Binding Background}" BorderThickness="2">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource ChoiceButton}">
                <Setter Property="BorderBrush" Value="Transparent" />
                <Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="BorderBrush" Value="{Binding Foreground}" /></DataTrigger></Style.Triggers>
              </Style>
            </Button.Style>
            <Ellipse Width="14" Height="14" Fill="{Binding Foreground}" />
          </Button>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <TextBlock Text="{x:Static app:Strings.FolderDescription}" FontSize="13" FontWeight="Medium" Margin="0,18,0,8" />
    <TextBox Style="{StaticResource HintTextBox}" Tag="{x:Static app:Strings.FolderDescriptionPlaceholder}" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
             Height="92" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Background="{StaticResource Sidebar}" Padding="10,8" AutomationProperties.Name="{x:Static app:Strings.FolderDescription}" />

    <TextBlock Text="{x:Static app:Strings.Workspace}" FontSize="13" FontWeight="Medium" Margin="0,18,0,8" />
    <Border Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="9" Padding="14">
      <StackPanel Orientation="Horizontal">
        <controls:Icon Kind="Lock" Size="14" Foreground="{StaticResource Muted}" Margin="0,0,9,0" />
        <TextBlock Text="{x:Static app:Strings.TabMyNotes}" FontSize="14" />
      </StackPanel>
    </Border>
    <TextBlock Text="{x:Static app:Strings.PrivateFolders}" Style="{StaticResource Meta}" Margin="0,8,0,0" />
    <TextBlock Text="{Binding Error}" Visibility="{Binding Error, Converter={StaticResource VisibleWhen}}" Foreground="{StaticResource Accent}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0" />

    <DockPanel Margin="0,24,0,0">
      <Button DockPanel.Dock="Left" Content="{x:Static app:Strings.DeleteFolderMenu}" Command="{Binding DeleteCommand}" Foreground="{StaticResource Accent}" Visibility="{Binding Creating, Converter={StaticResource VisibleWhen}, ConverterParameter=not}" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="{x:Static app:Strings.Cancel}" Command="{Binding CancelCommand}" IsCancel="True" MinWidth="80" Margin="0,0,10,0" />
        <Button Content="{Binding SaveText}" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" IsDefault="True" MinWidth="80" />
      </StackPanel>
    </DockPanel>
  </StackPanel>
</Window>
