<UserControl x:Class="Wallfly.App.Dialogs.AiLanguageSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:Wallfly.App"
             xmlns:controls="clr-namespace:Wallfly.App.Controls">
  <UserControl.Resources>
    <controls:VisibleWhen x:Key="VisibleWhen" />
    <Style x:Key="KeyStatus" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0,6,0,0" />
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
    </Style>
  </UserControl.Resources>
  <StackPanel>
    <!-- Transcription -->
    <TextBlock Text="{x:Static app:Strings.SectionTranscription}" Style="{StaticResource SectionHeader}" Margin="4,0,0,8" />
    <Border Style="{StaticResource Card}">
      <StackPanel>
        <DockPanel>
          <ComboBox DockPanel.Dock="Right" Width="300" ItemsSource="{Binding TranscriptionProviders}" SelectedItem="{Binding SelectedTranscriptionProvider}" DisplayMemberPath="Label" AutomationProperties.Name="{x:Static app:Strings.SectionTranscription}" />
          <TextBlock Text="{x:Static app:Strings.Service}" VerticalAlignment="Center" FontSize="13" />
        </DockPanel>
        <DockPanel Margin="0,10,0,0">
          <controls:Icon DockPanel.Dock="Left" Size="13" VerticalAlignment="Top" Margin="0,2,7,0">
            <controls:Icon.Style>
              <Style TargetType="controls:Icon">
                <Setter Property="Kind" Value="Team" />
                <Setter Property="Foreground" Value="{StaticResource Muted}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding SpeakerHintIsWarning}" Value="True"><Setter Property="Kind" Value="Warning" /><Setter Property="Foreground" Value="{StaticResource Accent}" /></DataTrigger>
                </Style.Triggers>
              </Style>
            </controls:Icon.Style>
          </controls:Icon>
          <TextBlock Text="{x:Static app:Strings.SpeakerQualityHint}" FontSize="12" TextWrapping="Wrap">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource Muted}" />
                <Style.Triggers><DataTrigger Binding="{Binding SpeakerHintIsWarning}" Value="True"><Setter Property="Foreground" Value="{StaticResource Accent}" /></DataTrigger></Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </DockPanel>
        <Rectangle Height="1" Fill="{StaticResource Gray100}" Margin="0,12" />

        <StackPanel Visibility="{Binding IsDeepgram, Converter={StaticResource VisibleWhen}}">
          <TextBlock Text="{x:Static app:Strings.DeepgramPrivacy}" Style="{StaticResource Meta}" Margin="0,0,0,8" />
          <DockPanel>
            <PasswordBox DockPanel.Dock="Right" Width="300" controls:Secure.Password="{Binding DeepgramKey, Mode=TwoWay}" AutomationProperties.Name="{x:Static app:Strings.DeepgramKey}" />
            <TextBlock Text="{x:Static app:Strings.DeepgramKey}" VerticalAlignment="Center" FontSize="13" />
          </DockPanel>
          <TextBlock Text="{Binding DeepgramKeyStatus}">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource KeyStatus}">
                <Style.Triggers><DataTrigger Binding="{Binding DeepgramKeyMissing}" Value="True"><Setter Property="Foreground" Value="{StaticResource Accent}" /></DataTrigger></Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </StackPanel>

        <StackPanel Visibility="{Binding IsOpenAiTranscription, Converter={StaticResource VisibleWhen}}">
          <TextBlock Text="{x:Static app:Strings.OpenAiPrivacy}" Style="{StaticResource Meta}" Margin="0,0,0,8" />
          <DockPanel>
            <PasswordBox DockPanel.Dock="Right" Width="300" controls:Secure.Password="{Binding OpenAiKey, Mode=TwoWay}" AutomationProperties.Name="{x:Static app:Strings.OpenAiKey}" />
            <TextBlock Text="{x:Static app:Strings.OpenAiKey}" VerticalAlignment="Center" FontSize="13" />
          </DockPanel>
          <TextBlock Text="{Binding OpenAiKeyStatus}">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource KeyStatus}">
                <Style.Triggers><DataTrigger Binding="{Binding OpenAiKeyMissing}" Value="True"><Setter Property="Foreground" Value="{StaticResource Accent}" /></DataTrigger></Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </StackPanel>

        <StackPanel Visibility="{Binding IsLocalWhisper, Converter={StaticResource VisibleWhen}}">
          <TextBlock Text="{x:Static app:Strings.LocalPrivacy}" Style="{StaticResource Meta}" Margin="0,0,0,8" />
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="{x:Static app:Strings.Choose}" Command="{Binding ChooseWhisperAppCommand}" Margin="8,0,0,0" />
            <TextBox DockPanel.Dock="Right" Width="230" Text="{Binding WhisperAppPath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static app:Strings.WhisperApp}" />
            <TextBlock Text="{x:Static app:Strings.WhisperApp}" VerticalAlignment="Center" FontSize="13" />
          </DockPanel>
          <DockPanel Margin="0,8,0,0">
            <Button DockPanel.Dock="Right" Content="{x:Static app:Strings.Choose}" Command="{Binding ChooseWhisperModelCommand}" Margin="8,0,0,0" />
            <TextBox DockPanel.Dock="Right" Width="230" Text="{Binding WhisperModelPath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static app:Strings.WhisperModel}" />
            <TextBlock Text="{x:Static app:Strings.WhisperModel}" VerticalAlignment="Center" FontSize="13" />
          </DockPanel>
          <TextBlock Text="{Binding LocalStatus}">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource KeyStatus}">
                <Style.Triggers><DataTrigger Binding="{Binding LocalFound}" Value="False"><Setter Property="Foreground" Value="{StaticResource Accent}" /></DataTrigger></Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </StackPanel>

        <Rectangle Height="1" Fill="{StaticResource Gray100}" Margin="0,12" />
        <DockPanel>
          <ComboBox DockPanel.Dock="Right" Width="300" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" DisplayMemberPath="Label" AutomationProperties.Name="{x:Static app:Strings.SpokenLanguage}" />
          <TextBlock Text="{x:Static app:Strings.SpokenLanguage}" VerticalAlignment="Center" FontSize="13" />
        </DockPanel>
        <StackPanel Visibility="{Binding IsDeepgram, Converter={StaticResource VisibleWhen}}">
          <Rectangle Height="1" Fill="{StaticResource Gray100}" Margin="0,12" />
          <DockPanel>
            <TextBox DockPanel.Dock="Right" Width="300" Height="92" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                     Text="{Binding CustomVocabulary, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static app:Strings.CustomVocabulary}" />
            <TextBlock Text="{x:Static app:Strings.CustomVocabulary}" VerticalAlignment="Top" Margin="0,6,0,0" FontSize="13" />
          </DockPanel>
          <TextBlock Text="{x:Static app:Strings.CustomVocabularyDetail}" Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="0,8,0,0" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Enhancement (re-homed EnhancementSettingsSection) -->
    <TextBlock Text="{x:Static app:Strings.SectionEnhancement}" Style="{StaticResource SectionHeader}" />
    <Border Style="{StaticResource Card}" DataContext="{Binding Enhancement}">
      <StackPanel>
        <DockPanel>
          <ComboBox DockPanel.Dock="Right" Width="300" ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider}" DisplayMemberPath="Label" AutomationProperties.Name="{x:Static app:Strings.SectionEnhancement}" />
          <TextBlock Text="{x:Static app:Strings.Service}" VerticalAlignment="Center" FontSize="13" />
        </DockPanel>
        <StackPanel Visibility="{Binding DetailsVisible, Converter={StaticResource VisibleWhen}}">
          <TextBlock Text="{Binding PrivacyText}" Style="{StaticResource Meta}" Margin="0,10,0,0" />
          <Rectangle Height="1" Fill="{StaticResource Gray100}" Margin="0,12" />
          <DockPanel>
            <ComboBox DockPanel.Dock="Right" Width="300" IsEditable="True" ItemsSource="{Binding Models}" DisplayMemberPath="Name" TextSearch.TextPath="Id"
                      Text="{Binding ModelText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{x:Static app:Strings.ModelHint}" AutomationProperties.Name="{x:Static app:Strings.Model}" />
            <TextBlock Text="{x:Static app:Strings.Model}" VerticalAlignment="Center" FontSize="13" />
          </DockPanel>
          <DockPanel Margin="0,10,0,0" Visibility="{Binding EndpointVisible, Converter={StaticResource VisibleWhen}}">
            <TextBox DockPanel.Dock="Right" Width="300" Style="{StaticResource HintTextBox}" Tag="https://…/v1/chat/completions" Text="{Binding Endpoint, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static app:Strings.ApiAddress}" />
            <TextBlock Text="{x:Static app:Strings.ApiAddress}" VerticalAlignment="Center" FontSize="13" />
          </DockPanel>
          <DockPanel Margin="0,10,0,0" Visibility="{Binding AnthropicKeyVisible, Converter={StaticResource VisibleWhen}}">
            <PasswordBox DockPanel.Dock="Right" Width="300" controls:Secure.Password="{Binding AnthropicKey, Mode=TwoWay}" AutomationProperties.Name="{x:Static app:Strings.ApiKey}" />
            <TextBlock Text="{x:Static app:Strings.ApiKey}" VerticalAlignment="Center" FontSize="13" />
          </DockPanel>
          <StackPanel Margin="0,10,0,0" Visibility="{Binding OpenAiKeyVisible, Converter={StaticResource VisibleWhen}}">
            <DockPanel>
              <PasswordBox DockPanel.Dock="Right" Width="300" controls:Secure.Password="{Binding DataContext.OpenAiKey, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}" AutomationProperties.Name="{x:Static app:Strings.ApiKey}" />
              <TextBlock Text="{Binding OpenAiKeyLabel}" VerticalAlignment="Center" FontSize="13" />
            </DockPanel>
            <TextBlock Text="{x:Static app:Strings.SharedOpenAiKey}" Style="{StaticResource Meta}" Margin="0,6,0,0" />
          </StackPanel>
          <TextBlock Text="{Binding KeyStatusText}" Visibility="{Binding KeyStatusVisible, Converter={StaticResource VisibleWhen}}">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource KeyStatus}">
                <Style.Triggers><DataTrigger Binding="{Binding KeyMissing}" Value="True"><Setter Property="Foreground" Value="{StaticResource Accent}" /></DataTrigger></Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <DockPanel Margin="0,6,0,0" Visibility="{Binding Issue, Converter={StaticResource VisibleWhen}}">
            <controls:Icon DockPanel.Dock="Left" Kind="Warning" Size="12" Foreground="{StaticResource Accent}" VerticalAlignment="Top" Margin="0,2,6,0" />
            <TextBlock Text="{Binding Issue}" Foreground="{StaticResource Accent}" FontSize="12" TextWrapping="Wrap" />
          </DockPanel>
          <Button Content="{x:Static app:Strings.CreateApiKey}" Style="{StaticResource LinkButton}" Command="{Binding CreateKeyCommand}" Margin="0,8,0,0" Visibility="{Binding CreateKeyVisible, Converter={StaticResource VisibleWhen}}" />
          <Expander Header="{x:Static app:Strings.Advanced}" Margin="0,8,0,0" Visibility="{Binding AdvancedVisible, Converter={StaticResource VisibleWhen}}">
            <DockPanel Margin="18,6,0,0">
              <TextBox DockPanel.Dock="Right" Width="282" Text="{Binding WorkspaceID, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static app:Strings.WorkspaceId}" />
              <TextBlock Text="{x:Static app:Strings.WorkspaceId}" VerticalAlignment="Center" FontSize="13" />
            </DockPanel>
          </Expander>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- My to-dos -->
    <TextBlock Text="{x:Static app:Strings.SectionMyTodos}" Style="{StaticResource SectionHeader}" />
    <Border Style="{StaticResource Card}" DataContext="{Binding Enhancement}">
      <StackPanel>
        <DockPanel>
          <TextBox DockPanel.Dock="Right" Width="300" Style="{StaticResource HintTextBox}" Tag="{x:Static app:Strings.YourNameHint}" Text="{Binding OwnerName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static app:Strings.YourName}" />
          <TextBlock Text="{x:Static app:Strings.YourName}" VerticalAlignment="Center" FontSize="13" />
        </DockPanel>
        <TextBlock Text="{x:Static app:Strings.YourNameDetail}" Style="{StaticResource Meta}" Margin="0,8,0,0" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
