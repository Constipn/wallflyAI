<UserControl x:Class="Wallfly.App.Dialogs.StorageSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:Wallfly.App"
             xmlns:controls="clr-namespace:Wallfly.App.Controls">
  <UserControl.Resources>
    <controls:VisibleWhen x:Key="VisibleWhen" />
  </UserControl.Resources>
  <StackPanel>
    <TextBlock Text="{x:Static app:Strings.SectionStorageLocation}" Style="{StaticResource SectionHeader}" Margin="4,0,0,8" />
    <Border Style="{StaticResource Card}">
      <StackPanel>
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="{x:Static app:Strings.ShowInExplorer}" Command="{Binding ShowLibraryCommand}" Margin="8,0,0,0" VerticalAlignment="Center" />
          <Button DockPanel.Dock="Right" Content="{x:Static app:Strings.Change}" Command="{Binding ChangeLocationCommand}" ToolTip="{x:Static app:Strings.StorageChangeHint}" Margin="12,0,0,0" VerticalAlignment="Center" />
          <StackPanel>
            <TextBlock Text="{x:Static app:Strings.FolderLabel}" FontSize="13" />
            <TextBlock Text="{Binding LibraryPath}" ToolTip="{Binding LibraryPath}" Foreground="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
          </StackPanel>
        </DockPanel>
        <TextBlock Text="{x:Static app:Strings.StorageDetail}" Style="{StaticResource Meta}" Margin="0,10,0,0" />
        <DockPanel Margin="0,6,0,0" Visibility="{Binding StorageStatus, Converter={StaticResource VisibleWhen}}">
          <controls:Spinner DockPanel.Dock="Left" Size="11" Margin="0,2,7,0" VerticalAlignment="Top" Visibility="{Binding IsMovingLibrary, Converter={StaticResource VisibleWhen}}" />
          <TextBlock Text="{Binding StorageStatus}" FontSize="12" Foreground="{StaticResource Ink}" TextWrapping="Wrap" AutomationProperties.AutomationId="StorageStatus" />
        </DockPanel>
      </StackPanel>
    </Border>

    <TextBlock Text="{x:Static app:Strings.SectionAudioAfter}" Style="{StaticResource SectionHeader}" />
    <Border Style="{StaticResource Card}">
      <StackPanel>
        <RadioButton Style="{StaticResource OptionRadio}" GroupName="AudioRetention" IsChecked="{Binding KeepAudio}">
          <StackPanel>
            <TextBlock Text="{x:Static app:Strings.KeepAudio}" FontSize="13" />
            <TextBlock Text="{x:Static app:Strings.KeepAudioDetail}" Style="{StaticResource Meta}" Margin="0,2,0,0" />
          </StackPanel>
        </RadioButton>
        <RadioButton Style="{StaticResource OptionRadio}" GroupName="AudioRetention" IsChecked="{Binding DeleteAutomatically}" Margin="0,12,0,0">
          <StackPanel>
            <TextBlock Text="{x:Static app:Strings.DeleteAutomatically}" FontSize="13" />
            <TextBlock Text="{Binding DeleteDetail}" Style="{StaticResource Meta}" Margin="0,2,0,0" />
          </StackPanel>
        </RadioButton>
        <TextBlock Text="{x:Static app:Strings.AppliesToNew}" Style="{StaticResource Meta}" Margin="0,12,0,0" />
        <ItemsControl ItemsSource="{Binding PendingDeletions}" Margin="0,4,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <DockPanel Margin="0,6,0,0">
                <Button DockPanel.Dock="Right" Content="{x:Static app:Strings.ErrorTryAgain}" Command="{Binding TryAgainCommand}" Margin="8,0,0,0" />
                <TextBlock Text="{Binding Text}" ToolTip="{Binding Detail}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              </DockPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <TextBlock Text="{x:Static app:Strings.SectionTranscriptCopy}" Style="{StaticResource SectionHeader}" />
    <Border Style="{StaticResource Card}">
      <StackPanel>
        <CheckBox Style="{StaticResource SwitchCheckBox}" Content="{x:Static app:Strings.MirrorToggle}" IsChecked="{Binding MirrorEnabled}" IsEnabled="{Binding HasMirrorFolder}" />
        <DockPanel Margin="0,10,0,0">
          <Button DockPanel.Dock="Right" Content="{x:Static app:Strings.ShowInExplorer}" Command="{Binding ShowMirrorFolderCommand}" Margin="8,0,0,0" Visibility="{Binding HasMirrorFolder, Converter={StaticResource VisibleWhen}}" />
          <Button DockPanel.Dock="Right" Content="{Binding ChooseMirrorText}" Command="{Binding ChooseMirrorFolderCommand}" Margin="12,0,0,0" />
          <TextBlock Text="{Binding MirrorPath}" ToolTip="{Binding MirrorPath}" Foreground="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        </DockPanel>
        <TextBlock Text="{x:Static app:Strings.MirrorDetail}" Style="{StaticResource Meta}" Margin="0,8,0,0" />
        <!-- Transcript copies that could not be written (the meeting itself is saved) -->
        <ItemsControl ItemsSource="{Binding MirrorErrors}" Margin="0,4,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <DockPanel Margin="0,6,0,0">
                <Button DockPanel.Dock="Right" Content="{x:Static app:Strings.ErrorTryAgain}" Command="{Binding TryAgainCommand}" Margin="8,0,0,0" />
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{Binding Text}" FontSize="12" Foreground="{StaticResource Accent}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Detail}" ToolTip="{Binding Detail}" Style="{StaticResource Meta}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                </StackPanel>
              </DockPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
