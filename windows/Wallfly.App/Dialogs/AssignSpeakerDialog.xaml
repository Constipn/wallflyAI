<Window x:Class="Wallfly.App.Dialogs.AssignSpeakerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:Wallfly.App"
        Style="{StaticResource AppWindow}" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner" Title="{x:Static app:Strings.AssignSegmentTitle}">
  <StackPanel Margin="28,24,28,20">
    <TextBlock Text="{x:Static app:Strings.AssignSegmentTitle}" FontSize="17" FontWeight="SemiBold" Margin="0,0,48,0" TextWrapping="Wrap" />
    <!-- The passage being assigned, shown as its Others bubble -->
    <Border Background="{StaticResource TranscriptOthers}" CornerRadius="4,14,14,14" Padding="13,9" Margin="0,14,0,0" HorizontalAlignment="Left">
      <TextBlock x:Name="Excerpt" FontSize="12" TextWrapping="Wrap" MaxHeight="54" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Ink}" />
    </Border>
    <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,16,0,0" Focusable="False">
      <StackPanel x:Name="Options" />
    </ScrollViewer>
    <TextBox x:Name="NameBox" MaxLength="160" Margin="25,0,0,0" IsEnabled="False" AutomationProperties.Name="{x:Static app:Strings.SpeakerNameLabel}" TextChanged="Name_Changed" />
    <TextBlock Text="{x:Static app:Strings.AssignSegmentDetail}" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="17" Margin="0,12,0,0" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
      <Button Content="{x:Static app:Strings.Cancel}" IsCancel="True" MinWidth="88" Margin="0,0,10,0" />
      <Button x:Name="AssignButton" Content="{x:Static app:Strings.Assign}" Style="{StaticResource PrimaryButton}" IsDefault="True" MinWidth="88" IsEnabled="False" Click="Assign_Click" />
    </StackPanel>
  </StackPanel>
</Window>
