<Window x:Class="Wallfly.App.Dialogs.QuitDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:Wallfly.App"
        xmlns:controls="clr-namespace:Wallfly.App.Controls"
        Style="{StaticResource AppWindow}" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner" Title="{x:Static app:Strings.AppName}">
  <DockPanel Margin="28,26,28,22">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
      <Button x:Name="ReturnButton" Content="{x:Static app:Strings.QuitReturn}" IsCancel="True" IsDefault="True" Margin="0,0,10,0" />
      <Button x:Name="SaveButton" Content="{x:Static app:Strings.QuitSaveAndEnd}" Style="{StaticResource PrimaryButton}" Click="Save_Click" />
    </StackPanel>
    <controls:Icon DockPanel.Dock="Left" Kind="Waveform" Size="26" Foreground="{StaticResource Accent}" VerticalAlignment="Top" Margin="0,2,16,0" />
    <StackPanel>
      <TextBlock x:Name="TitleText" Text="{x:Static app:Strings.QuitTitle}" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="20" TextWrapping="Wrap" Margin="0,0,48,0" />
      <TextBlock x:Name="DetailText" Text="{x:Static app:Strings.QuitDetail}" FontSize="13" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="19" />
    </StackPanel>
  </DockPanel>
</Window>
