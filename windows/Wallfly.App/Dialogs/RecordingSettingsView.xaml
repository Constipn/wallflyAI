<UserControl x:Class="Wallfly.App.Dialogs.RecordingSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:Wallfly.App"
             xmlns:controls="clr-namespace:Wallfly.App.Controls">
  <UserControl.Resources>
    <controls:VisibleWhen x:Key="VisibleWhen" />
  </UserControl.Resources>
  <StackPanel>
    <TextBlock Text="{x:Static app:Strings.SectionAudio}" Style="{StaticResource SectionHeader}" Margin="4,0,0,8" />
    <Border Style="{StaticResource Card}">
      <StackPanel>
        <DockPanel>
          <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Command="{Binding RefreshMicrophonesCommand}" ToolTip="{x:Static app:Strings.RefreshMicrophones}" AutomationProperties.Name="{x:Static app:Strings.RefreshMicrophones}" Margin="6,0,0,0">
            <controls:Icon Kind="Refresh" Size="13" />
          </Button>
          <ComboBox DockPanel.Dock="Right" Width="300" ItemsSource="{Binding Microphones}" SelectedItem="{Binding SelectedMicrophone}" DisplayMemberPath="Label" AutomationProperties.Name="{x:Static app:Strings.Microphone}" />
          <TextBlock Text="{x:Static app:Strings.Microphone}" VerticalAlignment="Center" FontSize="13" />
        </DockPanel>
        <TextBlock Text="{Binding DeviceIssue}" Visibility="{Binding DeviceIssue, Converter={StaticResource VisibleWhen}}" Foreground="{StaticResource Accent}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" />
        <Rectangle Height="1" Fill="{StaticResource Gray100}" Margin="0,12" />
        <DockPanel>
          <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Command="{Binding RefreshAppsCommand}" ToolTip="{x:Static app:Strings.RefreshApps}" AutomationProperties.Name="{x:Static app:Strings.RefreshApps}" Margin="6,0,0,0">
            <controls:Icon Kind="Refresh" Size="13" />
          </Button>
          <ComboBox DockPanel.Dock="Right" Width="300" ItemsSource="{Binding MeetingAudioOptions}" SelectedItem="{Binding SelectedMeetingAudio}" DisplayMemberPath="Label" AutomationProperties.Name="{x:Static app:Strings.MeetingAudio}" />
          <TextBlock Text="{x:Static app:Strings.MeetingAudio}" VerticalAlignment="Center" FontSize="13" />
        </DockPanel>
        <TextBlock Text="{Binding MeetingAudioDetail}" Style="{StaticResource Meta}" Margin="0,8,0,0" />
        <TextBlock Text="{Binding AppsIssue}" Visibility="{Binding AppsIssue, Converter={StaticResource VisibleWhen}}" Foreground="{StaticResource Accent}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
        <Rectangle Height="1" Fill="{StaticResource Gray100}" Margin="0,12" />
        <DockPanel Margin="0,0,34,0">
          <ComboBox DockPanel.Dock="Right" Width="300" ItemsSource="{Binding Outputs}" SelectedItem="{Binding SelectedOutput}" DisplayMemberPath="Label" AutomationProperties.Name="{x:Static app:Strings.OutputDevice}" />
          <TextBlock Text="{x:Static app:Strings.OutputDevice}" VerticalAlignment="Center" FontSize="13" TextWrapping="Wrap" Margin="0,0,12,0" />
        </DockPanel>
      </StackPanel>
    </Border>

    <TextBlock Text="{x:Static app:Strings.SectionSpeakers}" Style="{StaticResource SectionHeader}" />
    <Border Style="{StaticResource Card}">
      <StackPanel>
        <CheckBox Style="{StaticResource SwitchCheckBox}" Content="{x:Static app:Strings.UseTeamsNames}" IsChecked="{Binding TeamsSpeakerNames}" />
        <Rectangle Height="1" Fill="{StaticResource Gray100}" Margin="0,12" />
        <CheckBox Style="{StaticResource SwitchCheckBox}" Content="{x:Static app:Strings.MatchVoices}" IsChecked="{Binding MatchVoices}" />
        <TextBlock Text="{x:Static app:Strings.MatchVoicesDetail}" Style="{StaticResource Meta}" Margin="0,4,0,0" />
        <Rectangle Height="1" Fill="{StaticResource Gray100}" Margin="0,12" />
        <DockPanel IsEnabled="{Binding MatchVoices}">
          <ComboBox DockPanel.Dock="Right" Width="300" ItemsSource="{Binding SpeakerSeparations}" SelectedItem="{Binding SelectedSpeakerSeparation}" DisplayMemberPath="Label" AutomationProperties.Name="{x:Static app:Strings.SpeakerSeparation}" />
          <TextBlock Text="{x:Static app:Strings.SpeakerSeparation}" VerticalAlignment="Center" FontSize="13" />
        </DockPanel>
        <TextBlock Text="{Binding SpeakerSeparationDetail}" Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="0,8,0,0" />
      </StackPanel>
    </Border>

    <TextBlock Text="{x:Static app:Strings.SectionTeams}" Style="{StaticResource SectionHeader}" />
    <Border Style="{StaticResource Card}">
      <StackPanel>
        <CheckBox Style="{StaticResource SwitchCheckBox}" Content="{x:Static app:Strings.DetectTeams}" IsChecked="{Binding DetectTeams}" />
        <TextBlock Text="{x:Static app:Strings.DetectTeamsDetail}" Style="{StaticResource Meta}" Margin="0,4,0,0" />
        <!-- Wallfly Detector: status.json (< 8 s old), sign-in start, "Start helper now" -->
        <Border x:Name="HelperStatus" Visibility="{Binding HasDetection, Converter={StaticResource VisibleWhen}}" Background="{StaticResource Sidebar}" CornerRadius="6" Padding="10,8" Margin="0,10,0,0">
          <DockPanel>
            <Button DockPanel.Dock="Right" VerticalAlignment="Center" Content="{Binding DetectionActionText}" Command="{Binding StartHelperCommand}"
                    Visibility="{Binding DetectionActionText, Converter={StaticResource VisibleWhen}}" Margin="10,0,0,0" AutomationProperties.AutomationId="StartHelper" />
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding DetectionLine}" FontSize="12" Foreground="{StaticResource Ink}" TextWrapping="Wrap" AutomationProperties.AutomationId="HelperStatusLine" />
              <TextBlock Text="{Binding DetectionDetail}" Visibility="{Binding DetectionDetail, Converter={StaticResource VisibleWhen}}" Style="{StaticResource Meta}" Margin="0,2,0,0" />
              <TextBlock Text="{Binding DetectionAutostart}" Visibility="{Binding DetectionAutostart, Converter={StaticResource VisibleWhen}}" Style="{StaticResource Meta}" Margin="0,2,0,0" />
              <TextBlock Text="{Binding DetectionError}" Visibility="{Binding DetectionError, Converter={StaticResource VisibleWhen}}" Foreground="{StaticResource Accent}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" />
            </StackPanel>
          </DockPanel>
        </Border>
        <Rectangle Height="1" Fill="{StaticResource Gray100}" Margin="0,12" />
        <CheckBox Style="{StaticResource SwitchCheckBox}" Content="{x:Static app:Strings.AutoStop}" IsChecked="{Binding AutoStop}" />
        <Rectangle Height="1" Fill="{StaticResource Gray100}" Margin="0,12" />
        <CheckBox Style="{StaticResource SwitchCheckBox}" Content="{x:Static app:Strings.HideIndicator}" IsChecked="{Binding HideIndicatorFromCapture}" />
        <TextBlock Text="{x:Static app:Strings.HideIndicatorDetail}" Style="{StaticResource Meta}" Margin="0,4,0,0" />
        <Rectangle Height="1" Fill="{StaticResource Gray100}" Margin="0,12,0,4" />
        <Expander Header="{x:Static app:Strings.SectionTroubleshooting}">
          <StackPanel Margin="18,6,0,4">
            <WrapPanel>
              <Button Content="{x:Static app:Strings.OpenMicrophonePrivacy}" Command="{Binding OpenMicrophonePrivacyCommand}" Margin="0,0,8,8" />
              <Button Content="{x:Static app:Strings.OpenSoundSettings}" Command="{Binding OpenSoundSettingsCommand}" Margin="0,0,8,8" />
              <Button Content="{x:Static app:Strings.CopyDiagnostics}" Command="{Binding CopyDiagnosticsCommand}" Margin="0,0,8,8" />
            </WrapPanel>
            <TextBlock Text="{Binding DiagnosticsStatus}" Visibility="{Binding DiagnosticsStatus, Converter={StaticResource VisibleWhen}}" Style="{StaticResource Meta}" />
            <StackPanel Visibility="{Binding HasDetection, Converter={StaticResource VisibleWhen}}">
              <WrapPanel Margin="0,4,0,0">
                <Button Content="{x:Static app:Strings.CreateTeamsDiagnostics}" Command="{Binding CreateTeamsDiagnosticsCommand}" Margin="0,0,8,8" />
                <Button Content="{x:Static app:Strings.OpenDetectionFolder}" Command="{Binding OpenDetectionFolderCommand}" Margin="0,0,8,8" />
              </WrapPanel>
              <TextBlock Text="{Binding DetectionDiagnosticStatus}" Visibility="{Binding DetectionDiagnosticStatus, Converter={StaticResource VisibleWhen}}" Style="{StaticResource Meta}" Margin="0,0,0,8" />
              <CheckBox Style="{StaticResource SwitchCheckBox}" Content="{x:Static app:Strings.MicPrefilter}" IsChecked="{Binding MicPrefilter}" IsEnabled="{Binding DetectTeams}" Margin="0,4,0,0" />
              <TextBlock Text="{x:Static app:Strings.MicPrefilterDetail}" Style="{StaticResource Meta}" Margin="0,4,0,0" />
            </StackPanel>
          </StackPanel>
        </Expander>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
