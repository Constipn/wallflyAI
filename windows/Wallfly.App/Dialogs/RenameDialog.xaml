<Window x:Class="Wallfly.App.Dialogs.RenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:Wallfly.App"
        Style="{StaticResource AppWindow}" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner" Title="{x:Static app:Strings.RenameMeetingTitle}"
        FocusManager.FocusedElement="{Binding ElementName=NameBox}">
  <StackPanel Margin="28,24,28,20">
    <TextBlock Text="{x:Static app:Strings.RenameMeetingTitle}" FontSize="17" FontWeight="SemiBold" Margin="0,0,48,0" TextWrapping="Wrap" />
    <TextBlock Text="{x:Static app:Strings.MeetingName}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,16,0,5" />
    <TextBox x:Name="NameBox" AutomationProperties.Name="{x:Static app:Strings.MeetingName}" TextChanged="Name_Changed" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
      <Button Content="{x:Static app:Strings.Cancel}" IsCancel="True" MinWidth="88" Margin="0,0,10,0" />
      <Button x:Name="RenameButton" Content="{x:Static app:Strings.Rename}" Style="{StaticResource PrimaryButton}" IsDefault="True" MinWidth="88" Click="Rename_Click" />
    </StackPanel>
  </StackPanel>
</Window>
