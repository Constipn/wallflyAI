<UserControl x:Class="Wallfly.App.Views.FolderPickerButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:Wallfly.App"
             xmlns:controls="clr-namespace:Wallfly.App.Controls">
  <UserControl.Resources>
    <controls:VisibleWhen x:Key="VisibleWhen" />
  </UserControl.Resources>
  <Grid>
    <Button x:Name="Capsule" Style="{StaticResource CapsuleButton}" Background="{Binding Background}" Foreground="{Binding Foreground}" IsEnabled="{Binding IsEnabled}"
            Click="Capsule_Click" ToolTip="{x:Static app:Strings.AssignFolder}" AutomationProperties.Name="{x:Static app:Strings.AssignFolder}">
      <StackPanel Orientation="Horizontal">
        <controls:Icon Kind="{Binding Icon}" Size="15" Margin="0,0,7,0" VerticalAlignment="Center" />
        <TextBlock Text="{Binding Label}" MaxWidth="200" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
      </StackPanel>
    </Button>
    <Popup IsOpen="{Binding IsOpen}" StaysOpen="False" PlacementTarget="{Binding ElementName=Capsule}" Placement="Bottom" VerticalOffset="6" AllowsTransparency="True" PopupAnimation="Fade">
      <Border Background="{StaticResource Paper}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="18,16" Width="260" Margin="0,0,8,8">
        <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.12" /></Border.Effect>
        <StackPanel>
          <TextBlock Text="{x:Static app:Strings.MoveToFolder}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" />
          <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Options}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Style="{StaticResource PlainButton}" Padding="6,7" Command="{Binding DataContext.MoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                    <DockPanel>
                      <controls:Icon DockPanel.Dock="Right" Kind="Check" Size="12" Visibility="{Binding IsCurrent, Converter={StaticResource VisibleWhen}}" />
                      <controls:Icon Kind="{Binding Icon}" Size="14" Foreground="{Binding Foreground}" Margin="0,0,8,0" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding Name}" Foreground="{Binding Foreground}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </DockPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <Rectangle Height="1" Fill="{StaticResource Line}" Margin="0,8" />
          <Button Style="{StaticResource PlainButton}" Padding="6,6" Command="{Binding CreateFolderCommand}">
            <StackPanel Orientation="Horizontal">
              <controls:Icon Kind="FolderAdd" Size="14" Margin="0,0,8,0" />
              <TextBlock Text="{x:Static app:Strings.CreateFolderEllipsis}" FontSize="13" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Border>
    </Popup>
  </Grid>
</UserControl>
