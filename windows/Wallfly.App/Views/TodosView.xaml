<UserControl x:Class="Wallfly.App.Views.TodosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:Wallfly.App"
             xmlns:controls="clr-namespace:Wallfly.App.Controls">
  <UserControl.Resources>
    <controls:VisibleWhen x:Key="VisibleWhen" />
    <!-- One folder group: icon, name, count, then the rows with separators. -->
    <DataTemplate x:Key="TodoGroup">
      <StackPanel Margin="0,0,0,28">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
          <controls:Icon Kind="{Binding Icon}" Size="14" Foreground="{StaticResource Muted}" Margin="0,0,8,0" VerticalAlignment="Center" />
          <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" />
          <TextBlock Text="{Binding Count}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="8,0,0,0" />
        </StackPanel>
        <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel>
                <DockPanel Margin="0,10">
                  <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsCompleted}" Margin="0,1,12,0" VerticalAlignment="Top" AutomationProperties.Name="{Binding AutomationName}" />
                  <StackPanel>
                    <TextBlock Text="{Binding Text}" FontSize="14" TextWrapping="Wrap">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Foreground" Value="{StaticResource Ink}" />
                          <Style.Triggers><DataTrigger Binding="{Binding IsCompleted}" Value="True"><Setter Property="TextDecorations" Value="Strikethrough" /><Setter Property="Foreground" Value="{StaticResource Muted}" /></DataTrigger></Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding Owner}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,7,0,0" Visibility="{Binding Owner, Converter={StaticResource VisibleWhen}}" />
                    <Button Style="{StaticResource PlainButton}" Command="{Binding OpenMeetingCommand}" HorizontalAlignment="Left" Margin="0,7,0,0" ToolTip="{x:Static app:Strings.OpenSourceMeeting}">
                      <StackPanel Orientation="Horizontal">
                        <controls:Icon Kind="ArrowUpRight" Size="11" Foreground="{StaticResource Link}" Margin="0,0,5,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding MeetingLink}" FontSize="12" Foreground="{StaticResource Link}" TextWrapping="Wrap" />
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </DockPanel>
                <Rectangle Height="1" Fill="{StaticResource Line}" Margin="30,0,0,0" Opacity="0.7" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <!-- Left-aligned, at most 920 px wide (macOS frame(maxWidth: 920, alignment: .leading)). -->
    <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="996" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <StackPanel Margin="38">
      <Button Style="{StaticResource PrimaryButton}" Command="{Binding GoToRecordingCommand}" HorizontalAlignment="Left" Margin="0,0,0,28" Visibility="{Binding HasActiveMeeting, Converter={StaticResource VisibleWhen}}">
        <StackPanel Orientation="Horizontal">
          <controls:Icon Kind="Waveform" Size="13" Margin="0,0,7,0" VerticalAlignment="Center" />
          <TextBlock Text="{Binding GoToRecordingText}" MaxWidth="520" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Button>

      <!-- Introduction card: only with an empty library, dismissible, with "Load example" -->
      <Border Background="{StaticResource Sidebar}" CornerRadius="12" Padding="18" Margin="0,0,0,28" Visibility="{Binding ShowIntroduction, Converter={StaticResource VisibleWhen}}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Command="{Binding DismissIntroductionCommand}" VerticalAlignment="Top" ToolTip="{x:Static app:Strings.HideIntroduction}" AutomationProperties.Name="{x:Static app:Strings.HideIntroduction}">
            <controls:Icon Kind="Close" Size="11" />
          </Button>
          <controls:Icon DockPanel.Dock="Left" Kind="Leaf" Size="25" Foreground="{StaticResource Accent}" StrokeWidth="1.2" VerticalAlignment="Top" Margin="0,0,14,0" />
          <StackPanel>
            <TextBlock Text="{x:Static app:Strings.IntroTitle}" FontFamily="{StaticResource DisplayFont}" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Text="{x:Static app:Strings.IntroDetail}" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <Button Content="{x:Static app:Strings.IntroSetUpEnhancement}" Style="{StaticResource LinkButton}" Command="{Binding SetUpEnhancementCommand}" Margin="0,0,18,0" />
              <Button Content="{x:Static app:Strings.IntroLoadExample}" Style="{StaticResource LinkButton}" Command="{Binding LoadExampleCommand}" />
            </StackPanel>
          </StackPanel>
        </DockPanel>
      </Border>

      <WrapPanel Margin="0,0,0,28">
        <TextBlock Text="{x:Static app:Strings.TodosTitle}" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="34" Foreground="{StaticResource Ink}" Margin="0,0,12,0" />
        <TextBlock Text="{Binding OpenCountText}" FontSize="13" Foreground="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="0,0,0,8" />
      </WrapPanel>

      <StackPanel Orientation="Horizontal" Margin="0,0,0,28" Visibility="{Binding IsExtracting, Converter={StaticResource VisibleWhen}}">
        <controls:Spinner Size="13" Margin="0,0,10,0" />
        <TextBlock Text="{Binding ProgressText}" FontSize="12" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
      </StackPanel>

      <Border Background="{StaticResource Sidebar}" CornerRadius="10" Padding="16" Margin="0,0,0,28" Visibility="{Binding HasRetry, Converter={StaticResource VisibleWhen}}">
        <StackPanel>
          <TextBlock Text="{x:Static app:Strings.TasksPending}" FontSize="12" FontWeight="Medium" Margin="0,0,0,8" />
          <ItemsControl ItemsSource="{Binding NeedsRetry}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="0,4">
                  <Button DockPanel.Dock="Right" Content="{x:Static app:Strings.RetryTaskDetection}" Command="{Binding RetryCommand}" FontSize="12" Margin="16,0,0,0" />
                  <Button Content="{Binding Title}" Style="{StaticResource LinkButton}" Command="{Binding OpenCommand}" VerticalAlignment="Center" />
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <ItemsControl ItemsSource="{Binding Reviews}" Focusable="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Command="{Binding ReviewCommand}" HorizontalAlignment="Left" Margin="0,0,0,14">
              <StackPanel Orientation="Horizontal">
                <controls:Icon Kind="Checklist" Size="13" Margin="0,0,7,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Text}" MaxWidth="560" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <StackPanel Margin="0,16,0,30" Visibility="{Binding HasOpen, Converter={StaticResource VisibleWhen}, ConverterParameter=not}">
        <controls:Icon Kind="Check" Size="30" Foreground="{StaticResource Accent}" HorizontalAlignment="Left" StrokeWidth="1.2" />
        <TextBlock Text="{Binding EmptyTitle}" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="19" Margin="0,12,0,0" />
        <TextBlock Text="{x:Static app:Strings.TodosEmptyDetail}" FontSize="13" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,12,0,0" />
      </StackPanel>
      <ItemsControl ItemsSource="{Binding OpenGroups}" ItemTemplate="{StaticResource TodoGroup}" Focusable="False" />

      <StackPanel Visibility="{Binding HasDone, Converter={StaticResource VisibleWhen}}">
        <Rectangle Height="1" Fill="{StaticResource Line}" Margin="0,0,0,10" />
        <Expander IsExpanded="{Binding IsDoneExpanded}">
          <Expander.Header>
            <TextBlock Text="{Binding DataContext.DoneHeader, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="13" FontWeight="Medium" Foreground="{StaticResource Muted}" />
          </Expander.Header>
          <ItemsControl ItemsSource="{Binding DoneGroups}" ItemTemplate="{StaticResource TodoGroup}" Focusable="False" Margin="0,20,0,0" />
        </Expander>
      </StackPanel>
    </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
