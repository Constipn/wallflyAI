<UserControl x:Class="Wallfly.App.Views.ErrorBanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:Wallfly.App"
             xmlns:views="clr-namespace:Wallfly.App.Views"
             xmlns:controls="clr-namespace:Wallfly.App.Controls">
  <UserControl.Resources>
    <controls:VisibleWhen x:Key="VisibleWhen" />
    <views:FirstLineConverter x:Key="FirstLine" />
  </UserControl.Resources>
  <!-- A calm card: the first line of the message, "Copy details" for everything else, plus at most one action ("Open settings" or "Try again"). -->
  <Border Background="{StaticResource Paper}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Margin="12,0,12,12" SnapsToDevicePixels="True"
          Visibility="{Binding HasError, Converter={StaticResource VisibleWhen}}">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="3" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{StaticResource Accent}" CornerRadius="7,0,0,7" />
      <DockPanel Grid.Column="1" Margin="12,10,8,10">
        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Command="{Binding DismissErrorCommand}" MinWidth="22" MinHeight="22" Padding="3" VerticalAlignment="Top"
                ToolTip="{x:Static app:Strings.DismissMessage}" AutomationProperties.Name="{x:Static app:Strings.DismissMessage}">
          <controls:Icon Kind="Close" Size="10" />
        </Button>
        <controls:Icon DockPanel.Dock="Left" Kind="Info" Size="14" Foreground="{StaticResource Muted}" Margin="0,2,10,0" VerticalAlignment="Top" />
        <StackPanel>
          <TextBlock Text="{Binding ErrorText, Mode=OneWay, Converter={StaticResource FirstLine}}" FontSize="13" Foreground="{StaticResource Ink}"
                     TextWrapping="Wrap" TextTrimming="CharacterEllipsis" LineHeight="18" LineStackingStrategy="BlockLineHeight" MaxHeight="36"
                     AutomationProperties.Name="{Binding ErrorText, Mode=OneWay}" />
          <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <Button Style="{StaticResource LinkButton}" Content="{Binding ErrorActionText}" Command="{Binding ErrorActionCommand}" Margin="0,0,16,0"
                    Visibility="{Binding ErrorActionText, Converter={StaticResource VisibleWhen}}" />
            <Button Style="{StaticResource LinkButton}" Content="{x:Static app:Strings.CopyDetails}" Click="CopyDetails_Click" />
          </StackPanel>
        </StackPanel>
      </DockPanel>
    </Grid>
  </Border>
</UserControl>
